# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=auth_db
# Optional: override full JDBC URL
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/auth_db

# JWT
JWT_SECRET=supersecretkey-supersecretkey-supersecretkey-32bytes+
JWT_EXPIRATION_SECONDS=3600

# Logging / debug
JPA_SHOW_SQL=false
